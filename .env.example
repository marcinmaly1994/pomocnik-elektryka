# Adres projektu i klucz „anon/public" Supabase.
#
# Zostają tu WPISANE, bo klucz „publishable" jest z założenia jawny — trafia do
# paczki wysyłanej przeglądarce, więc każdy i tak odczyta go z działającej strony.
# Dostępu pilnują zasady RLS po stronie bazy, nie tajność tego ciągu. Dzięki temu
# `cp .env.example .env` wystarcza, żeby po sklonowaniu repo mieć działające konta.
VITE_SUPABASE_URL=https://wqfwrulbtpjgyyjubxud.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_8P8iaTQShpggLDM-waNvoQ_pmT0FlBA

# Konto testowe do testów e2e dotykających chmury (zapis, limity, nadpisywanie,
# odświeżanie sesji). Bez tych dwóch zmiennych pliki e2e/konto.spec.ts
# i e2e/rooms-reconcile-cloud.spec.ts są POMIJANE — reszta zestawu działa po samym
# sklonowaniu repo.
#
# PUSTE I TAKIE MAJĄ ZOSTAĆ. Stały tu kiedyś prawdziwy adres i prawdziwe hasło,
# co jest czymś zupełnie innym niż klucz „anon" wyżej: hasło nie jest jawne z
# założenia, a plik jest śledzony w gicie, więc dane siedzą też w HISTORII —
# usunięcie ich z tego pliku samo w sobie ich stamtąd nie zabiera. Hasło do tego
# konta wymaga więc zmiany po stronie Supabase, niezależnie od tej zmiany w repo.
#
# Wpisz swoje w `.env` (ten plik jest w .gitignore), a w CI podaj je jako sekrety
# repozytorium E2E_TEST_EMAIL i E2E_TEST_PASSWORD — patrz krok „Przygotuj .env"
# w .github/workflows/sprawdzenia.yml, który celowo NIE bierze ich z tego pliku.
#
# Załóż OSOBNE konto w Supabase, wyłącznie do testów: testy kasują z niego
# wszystkie zapisy o nazwach zaczynających się od „E2E-TEST”.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
